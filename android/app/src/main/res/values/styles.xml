<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#35bfff</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- Bottom-screen Presentation: no dialog dim (avoids greying the top Activity). -->
    <style name="CompanionPresentationTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:backgroundDimAmount">0</item>
        <item name="android:windowIsFloating">false</item>
    </style>
</resources>
